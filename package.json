{
  "name": "extensions-monitor",
  "displayName": "extensions-monitor",
  "description": "Monitors and blocks AI-assisted coding extensions on VSCode. Useful in academic settings or technical interviews where AI tools must not be used.",
  "version": "1.15.0",
  "license": "Commercial",
  "publisher": "skanderturki",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "VSCode extensions",
    "Monitor extensions",
    "Block extensions",
    "VSCode exams",
    "Technical interviews"
  ],
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/skanderturki/extensions-monitor"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.listInstalledExtensions",
        "title": "Extensions Monitor: List Installed Extensions"
      }
    ],
    "keybindings": [
      {
        "command": "extension.listInstalledExtensions",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Extensions Monitor",
      "properties": {
        "monitoredExtensions.blockedList": {
          "type": "array",
          "default": [],
          "description": "List of extensions to block.",
          "items": {
            "type": "string"
          }
        },
        "monitoredExtensions.whiteList": {
          "type": "array",
          "default": [
            "ecmel.vscode-html-css",
            "skanderturki.extensions-monitor",
            "skanderturki.html-snippets-ska",
            "christian-kohler.npm-intellisense",
            "redhat.vscode-xml",
            "rangav.vscode-thunder-client",
            "esbenp.prettier-vscode",
            "mongodb.mongodb-vscode",
            "ritwickdey.liveserver",
            "zainchen.json",
            "formulahendry.vscode-mysql",
            "mtxr.sqltools-driver-mysql",
            "cweijan.vscode-mysql-client2",
            "ms-vscode.vscode-typescript-next",
            "cweijan.dbclient-jdbc",
            "ms-toolsai.jupyter-keymap",
            "ms-vscode.cpptools",
            "ms-toolsai.jupyter",
            "ms-python.vscode-pylance",
            "ms-python.python",
            "twxs.cmake",
            "ms-vscode.cmake-tools",
            "redhat.java",
            "ms-azuretools.vscode-docker",
            "dbaeumer.vscode-eslint",
            "ms-vscode.cpptools-themes",
            "vscjava.vscode-java-debug",
            "vscjava.vscode-maven",
            "ms-vscode-remote.remote-wsl",
            "xabikos.JavaScriptSnippets",
            "standard.vscode-standard",
            "Wscats.html-snippets",
            "numso.prettier-standard-vscode",
            "cmstead.js-codeformer",
            "yandeu.five-server",
            "negokaz.live-server-preview"
          ],
          "description": "List of extensions to allow (bypasses blocking).",
          "items": {
            "type": "string"
          }
        },
        "extensionsMonitor.pollIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 300,
          "description": "How often (in seconds) to check installed extensions for banned items."
        },
        "extensionsMonitor.unlockGraceSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 300,
          "description": "Grace period (in seconds) after a successful unlock during which extensions are not re-checked."
        },
        "extensionsMonitor.logFilePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the activity log file. Leave empty to use ~/Desktop/log/extensions_log.txt."
        },
        "extensionsMonitor.maxPasswordAttempts": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of consecutive password attempts before the prompt stops re-appearing until the next check interval."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extensions-monitor-explorer",
          "title": "Extensions monitor",
          "icon": "actionbar_icon.svg"
        }
      ]
    },
    "views": {
      "extensions-monitor-explorer": [
        {
          "type": "webview",
          "id": "extensions-monitor-view",
          "name": "Extensions Monitor"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.0"
  }
}
